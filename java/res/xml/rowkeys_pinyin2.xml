<?xml version="1.0" encoding="utf-8"?>
<!--
    MyKey — Chinese Pinyin home row: a s d f g h j k l with tone marks.
-->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+0101 "ā" U+00E1 "á" U+01CE "ǎ" U+00E0 "à" -->
    <Key
        latin:keySpec="a"
        latin:moreKeys="&#x0101;,&#x00E1;,&#x01CE;,&#x00E0;" />
    <Key latin:keySpec="s" />
    <Key latin:keySpec="d" />
    <Key latin:keySpec="f" />
    <Key latin:keySpec="g" />
    <Key latin:keySpec="h" />
    <Key latin:keySpec="j" />
    <Key latin:keySpec="k" />
    <Key latin:keySpec="l" />
</merge>
